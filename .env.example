# Copia este archivo como ".env.local" para probar en tu computadora,
# y agrega las mismas variables en Vercel → Settings → Environment Variables.
# NUNCA subas el archivo .env.local real a GitHub.

# Cadena de conexión de tu base de datos Neon (Postgres)
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/neondb?sslmode=require

# Hash bcrypt de la contraseña del administrador (generalo con scripts/generar-hash.js, NO pegues la contraseña en texto plano aquí)
ADMIN_PASSWORD_HASH=

# Hash bcrypt de la contraseña de la CAJERA (mismo script, otra contraseña).
# Con esta contraseña se entra a una vista reducida: solo Ventas/Facturar y Pago móvil.
# Si la dejas vacía, el usuario "cajera" simplemente no existe todavía.
CAJERA_PASSWORD_HASH=

# Clave secreta para firmar la sesión del admin (cualquier texto largo y aleatorio, ej: genera uno en https://generate-secret.vercel.app/32)
SESSION_SECRET=

# --- Integración Banco de Venezuela (API de Conciliación) ---
# Pega aquí la clave real SOLO en Vercel (Settings → Environment Variables), nunca en este archivo si lo vas a subir a git.
BDV_API_KEY=
BDV_API_BASE_URL=https://api.bancodevenezuela.com

# --- Integración Cashea (pago en cuotas) ---
# CASHEA_PRIVATE_API_KEY: SOLO va aquí en Vercel, nunca en el sitio web público (landing/catalogo.html).
# Se usa para confirmar o cancelar órdenes desde el panel de administración.
CASHEA_PRIVATE_API_KEY=
# La clave PÚBLICA sí va en el sitio web (landing/catalogo.html), no aquí. Se las da el equipo de Cashea.

# --- Facturación electrónica SENIAT (proveedor certificado, ej. Digital HKA / Unidigital) ---
# Estos datos te los da tu proveedor de facturación electrónica al contratar el servicio.
SENIAT_API_BASE_URL=
SENIAT_API_TOKEN=
SENIAT_RIF_EMISOR=
SENIAT_RAZON_SOCIAL=MAKD SHOP
SENIAT_DIRECCION_EMISOR=

# --- Envío de facturas por correo (Resend, gratis hasta cierto volumen: https://resend.com) ---
RESEND_API_KEY=
RESEND_FROM=MAKD SHOP <onboarding@resend.dev>


