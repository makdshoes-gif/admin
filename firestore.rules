rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    match /movements/{movementId} {
      allow read: if true;
      allow write: if isValidId(movementId);
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }

    match /cash_closures/{closureId} {
      allow read: if true;
      allow write: if isValidId(closureId);
    }

    match /layaways/{layawayId} {
      allow read: if true;
      allow write: if isValidId(layawayId);
    }

    match /store_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }
  }
}

